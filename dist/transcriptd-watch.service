# Alternative to the timer: long-running watch mode for near-instant pickup.
# Use EITHER this OR transcriptd.timer, not both.
[Unit]
Description=transcriptd: watch folder and transcribe on change
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/transcriptd --folder /srv/notes scan --watch
User=notes
EnvironmentFile=/etc/transcriptd/env
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ReadWritePaths=/srv/notes
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
